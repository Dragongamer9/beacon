{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Beacon",
  "version": "0.0.1",
  "identifier": "io.github.dragongamer9.beacon",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Beacon",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "backgroundColor": "#0f0d0b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm"],
    "category": "Game",
    "shortDescription": "Launcher for BFME, LOTR and other classic strategy games on Linux",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
