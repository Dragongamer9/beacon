[Desktop Entry]
Type=Application
Name=Beacon
GenericName=Battle for Middle-earth Launcher
Comment=Play The Battle for Middle-earth, BFME II and The Rise of the Witch-king on Linux
Exec=beacon-app %U
Icon=beacon
Categories=Game;StrategyGame;
Keywords=bfme;middle-earth;rotwk;wine;proton;
Actions=fullscreen;

[Desktop Action fullscreen]
Name=Open in fullscreen (Game Mode)
Exec=beacon-app --fullscreen
