[Desktop Entry]
Type=Application
Name=Beacon
GenericName=Classic Strategy Games Launcher
Comment=Play BFME, Age of the Ring, LOTR: Conquest and other classic strategy games on Linux
Exec=beacon-app %U
Icon=beacon
Categories=Game;StrategyGame;
Keywords=bfme;middle-earth;rotwk;aotr;conquest;lotr;universe at war;exigo;rise of legends;galactic battlegrounds;wine;proton;
Actions=fullscreen;

[Desktop Action fullscreen]
Name=Open in fullscreen (Game Mode)
Exec=beacon-app --fullscreen
