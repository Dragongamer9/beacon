[Desktop Entry]
Type=Application
Name=Beacon
GenericName=Lord of the Rings Games Launcher
Comment=Play the Battle for Middle-earth games, Age of the Ring and LOTR: Conquest on Linux
Exec=beacon-app %U
Icon=beacon
Categories=Game;StrategyGame;
Keywords=bfme;middle-earth;rotwk;aotr;conquest;lotr;wine;proton;
Actions=fullscreen;

[Desktop Action fullscreen]
Name=Open in fullscreen (Game Mode)
Exec=beacon-app --fullscreen
